# Sao chép file này thành .env (cùng thư mục với config.py) rồi điền giá trị.
# LLM (proxy boltz.one) — đã có ở user env thì có thể bỏ qua dòng này:
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://ai.boltz.one/ai/anthropic

# Semantic Scholar API key (tùy chọn — để trống vẫn dùng được, chỉ bị rate limit thấp):
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex polite pool (khuyến khích, không bắt buộc):
OPENALEX_MAILTO=your_email@example.com
